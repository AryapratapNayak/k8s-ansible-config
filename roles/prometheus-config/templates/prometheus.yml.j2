global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - "{{ prometheus_config_dir }}/alert-rules.yml"

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - localhost:9090

  - job_name: node-exporter
    static_configs:
      - targets:
{% for target in prometheus_scrape_targets %}
          - "{{ target }}"
{% endfor %}
